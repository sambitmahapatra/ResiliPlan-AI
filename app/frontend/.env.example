# Frontend build-time config (Vite). Copy to .env.local for local dev.

# Base URL of the ResiliPlan FastAPI backend. In dev, leave blank to use the Vite
# proxy (/api -> http://127.0.0.1:8000). In production (Vercel), set to the deployed API.
VITE_API_BASE=

# Optional: Supabase (only if the frontend reads reference tables directly via supabase-js).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
