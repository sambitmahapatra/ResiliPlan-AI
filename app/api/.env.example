# Copy to .env and fill in to enable Supabase persistence (optional).
# Without these, the API still computes; it just won't store run history.

# From Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Service role key (server-side only; bypasses RLS). NEVER expose in the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key
# Or, if you prefer the anon key (RLS allows public run inserts in the provided schema):
# SUPABASE_ANON_KEY=your-anon-key

# CORS: comma-separated allowed origins, or * for any (dev). e.g. https://your-frontend.vercel.app
ALLOWED_ORIGINS=*
